# No keys needed for M1 (RSS + Hacker News ingestion).
# M2+ uses OpenCode Go (OpenAI-compatible gateway) for LLM curation.
OPENCODE_GO_API_KEY=
# deepseek-v4-flash (cheap, high quota) or deepseek-v4-pro
OPENCODE_GO_MODEL=deepseek-v4-flash
# Optional override (default: https://opencode.ai/zen/go/v1)
OPENCODE_GO_BASE_URL=
# Optional: max tokens per LLM call (default 128000)
OPENCODE_GO_MAX_TOKENS=128000
